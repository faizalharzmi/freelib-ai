# Copy to .env.production. Keep it private and do not commit it.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,freelib.cerdaslab.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://freelib.cerdaslab.com
